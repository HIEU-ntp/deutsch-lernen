// Deutsch Lernen — schema dữ liệu NGƯỜI DÙNG.
//
// Lưu ý kiến trúc: giáo trình (unit, từ vựng, ngữ pháp, bài tập) KHÔNG nằm trong
// database. Nó nằm ở các file JSON/YAML trong thư mục `content/` và được nạp qua
// `lib/content/loader.ts`. Database chỉ tham chiếu tới nội dung bằng chuỗi id
// (unitId, itemId, exerciseId). Nhờ vậy thêm bài học mới = thả thêm file JSON,
// không cần migrate database.
//
// Schema cố tình KHÔNG dùng enum và scalar list (giá trị hợp lệ được ràng buộc ở
// tầng ứng dụng bằng Zod), nên chuyển đổi giữa các hệ quản trị CSDL là không đau.
//
// Local dev dùng `npx prisma dev` — một Postgres chạy ngay trên máy, không cần
// Docker. Production dùng Postgres có sẵn (Neon / Prisma Postgres / Supabase).
// Nhờ vậy hai môi trường dùng chung một hệ CSDL, tránh lỗi chỉ xuất hiện khi deploy.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String

  /// Cấp độ người dùng đang học, ví dụ "A1.1" (gợi ý bởi placement test)
  currentLevel String @default("A1.1")

  xp            Int @default(0)
  streakCount   Int @default(0)
  longestStreak Int @default(0)

  /// Ngày học gần nhất dạng YYYY-MM-DD theo giờ địa phương của người dùng
  lastStudyDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  srsCards     SrsCard[]
  attempts     Attempt[]
  unitProgress UnitProgress[]
  badges       Badge[]
  placements   PlacementResult[]

  @@map("users")
}

/// Thẻ ôn tập ngắt quãng theo thuật toán SM-2.
/// Mỗi từ vựng / điểm ngữ pháp người dùng đã học sinh ra một thẻ.
model SrsCard {
  id     String @id @default(cuid())
  userId String

  /// id của item trong file nội dung (ví dụ "a1-1-u01-v-hallo")
  itemId String
  /// "vocab" | "grammar"
  itemType String
  level    String
  unitId   String

  // --- trạng thái SM-2 ---
  /// số lần trả lời đúng liên tiếp
  repetition Int   @default(0)
  /// khoảng cách tới lần ôn kế tiếp, tính bằng ngày
  interval   Int   @default(0)
  /// hệ số dễ (E-Factor), tối thiểu 1.3
  easeFactor Float @default(2.5)
  /// số lần quên (chất lượng nhớ < 3)
  lapses     Int   @default(0)

  dueDate        DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, dueDate])
  @@map("srs_cards")
}

/// Lịch sử từng lần trả lời bài tập — dùng để tính "điểm yếu" trên dashboard.
model Attempt {
  id     String @id @default(cuid())
  userId String

  unitId       String
  level        String
  exerciseId   String
  exerciseType String
  correct      Boolean

  /// Nhãn kỹ năng để phân tích điểm yếu: "noun-gender", "verb-conjugation",
  /// "word-order", "cases", "prepositions", "listening", "translation", ...
  skillTag String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, skillTag])
  @@map("attempts")
}

/// Tiến trình theo từng unit.
model UnitProgress {
  id     String @id @default(cuid())
  userId String

  unitId String
  level  String

  vocabDone     Boolean @default(false)
  grammarDone   Boolean @default(false)
  exercisesDone Boolean @default(false)

  /// điểm cao nhất của phần bài tập, theo phần trăm 0-100
  bestScore Int @default(0)

  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, level])
  @@map("unit_progress")
}

/// Huy hiệu đã đạt. `code` khớp với danh mục trong lib/gamification.ts
model Badge {
  id     String @id @default(cuid())
  userId String

  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("badges")
}

/// Kết quả bài kiểm tra xếp lớp.
model PlacementResult {
  id     String @id @default(cuid())
  userId String

  score          Int
  total          Int
  suggestedLevel String

  /// JSON: số câu đúng theo từng cấp độ, ví dụ {"A1.1":3,"A1.2":2}
  breakdown String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("placement_results")
}
